# ============================================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in your actual credentials
# ============================================================

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1

# Authentication & Security
JWT_SECRET=your_jwt_super_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DOCUMENT_BUCKET=documents

# Email / Notification Service (Brevo REST API - Port 443 HTTPS)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=AI StudyHub

# AI Model Credentials (Gemini & OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEXT_FALLBACK_MODELS=gemini-1.5-flash-8b,gemini-1.5-pro

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini
